# Server Configuration
PORT=5000

# MongoDB Database URI (e.g. mongodb://127.0.0.1:27017/engineering_notes_hub or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/engineering_notes_hub

# JWT Secret Key for token generation and verification
JWT_SECRET=your_jwt_secret_key_change_in_production

# CORS Allowed Origins (Comma-separated for multiple origins, or * for open development)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080
